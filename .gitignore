.env
.env.*
!.env.example
.DS_Store

# The source paintings the shape library was traced from. Reference material,
# not site assets, and not ours to redistribute -- assets/trace-shapes.py is
# the only thing that reads them, it is run by hand when the sources change,
# and what it writes into assets/img/shapes/traced/ is the committed record.
# Everything downstream builds from that, so the site does not need them.
ilya*.jpg
ilya*.jpeg

# The test suite's own machinery. The tests are committed; what runs them is
# not -- node_modules is large, platform-specific, and reinstallable from
# package.json with `npm install && npx playwright install chromium`.
node_modules/
test-results/
.playwright/
